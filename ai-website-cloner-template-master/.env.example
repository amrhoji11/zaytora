# Base URL of the ASP.NET Core Web API (no trailing slash).
#
# Local dev: run the API with `dotnet run` (uses the "http" launch profile
# by default, no cert trust needed) and point here:
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Once the API is deployed behind real HTTPS (or you've run
# `dotnet dev-certs https --trust` yourself), you can switch to:
# NEXT_PUBLIC_API_BASE_URL=https://localhost:5001/api
